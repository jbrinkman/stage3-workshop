<mxfile host="app.diagrams.net" agent="Kiro" version="24.0.0" type="device">
  <diagram id="stage3-edd-flow" name="EDD Data Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="stage3-workshop &#8212; promptfoo EDD Data Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="1000" height="40" as="geometry" />
        </mxCell>

        <!-- Section label: INPUTS -->
        <mxCell id="lbl-inputs" value="INPUTS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="260" height="20" as="geometry" />
        </mxCell>
        <!-- Section label: PROCESS -->
        <mxCell id="lbl-process" value="PROCESS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="300" height="20" as="geometry" />
        </mxCell>
        <!-- Section label: OUTPUT -->
        <mxCell id="lbl-output" value="OUTPUT" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#7f8c8d;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- Prompt node -->
        <mxCell id="node-prompt" value="&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;(review-pr-comments-prompt.md)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d;&quot;&gt;RTCC-style skill: classifies each PR review comment into a disposition (FIX / PARTIAL / OPTIONAL / OUT_OF_SCOPE / REJECT / DEPENDENT) and emits a machine-readable disposition block.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="130" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- Fixtures node -->
        <mxCell id="node-fixtures" value="&lt;b&gt;Fixtures&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;(fixtures/&amp;lt;name&amp;gt;/)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d;&quot;&gt;Each fixture has source code (pr-under-review.md / source/*.js) and review comments (comments.md), plus a per-fixture expected ground-truth map. Two fixtures today: math-app, text-utils.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="260" height="150" as="geometry" />
        </mxCell>

        <!-- Evals node -->
        <mxCell id="node-evals" value="&lt;b&gt;Evals&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;(promptfoo)&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d;&quot;&gt;promptfooconfig.yaml + review-comments-tests.yaml run the Prompt over each Fixture via the Kiro CLI provider (claude-sonnet-4.6, kiro.js).&lt;br&gt;&lt;br&gt;Deterministic-heavy assertions (eval-review-comments.js parses the disposition block + checks per-comment classification) plus a few gated llm-rubric checks for reasoning quality.&lt;br&gt;&lt;br&gt;&lt;b&gt;32 assertions across 2 fixtures.&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;spacingTop=12;spacingLeft=12;spacingRight=12;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="460" y="180" width="300" height="250" as="geometry" />
        </mxCell>

        <!-- Results node -->
        <mxCell id="node-results" value="&lt;b&gt;Results &amp;amp; Evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#4d4d4d;&quot;&gt;Pass/fail per metric via &lt;font face=&quot;Courier New&quot;&gt;task metrics&lt;/font&gt; (scripts/summarize.js), recorded step-over-step in ITERATION_LOG.md with git Step-N tags for the Red/Green iteration history.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=top;spacingTop=12;spacingLeft=10;spacingRight=10;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="860" y="230" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Edge: Prompt -> Evals -->
        <mxCell id="edge-prompt-evals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="node-prompt" target="node-evals">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Fixtures -> Evals -->
        <mxCell id="edge-fixtures-evals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="node-fixtures" target="node-evals">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edge: Evals -> Results -->
        <mxCell id="edge-evals-results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="node-evals" target="node-results">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
